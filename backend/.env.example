# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Django ---
# Generate: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOG_LEVEL=INFO
DJANGO_ADMIN_URL=admin/
# Development settings are the default for manage.py; use config.settings.production when deploying.
# DJANGO_SETTINGS_MODULE=config.settings.development

# --- PostgreSQL ---
DB_NAME=infraon_flow
DB_USER=infraon_flow
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# --- JWT (Simple JWT) ---
# Use a separate long random value in staging/production; defaults to DJANGO_SECRET_KEY if unset.
#JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=10
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_LEEWAY_SECONDS=10
# Refresh-token cookie: False only for local http development; always True in staging/production.
# AUTH_REFRESH_COOKIE_SECURE=False


# --- CORS / CSRF ---
CORS_ALLOWED_ORIGINS=http://localhost:4200
CSRF_TRUSTED_ORIGINS=http://localhost:4200

# --- Production only ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=0
